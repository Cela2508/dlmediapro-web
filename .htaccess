# ==========================================================
# DL MEDIA PRO — Configuración Apache / LiteSpeed (.htaccess)
# ==========================================================

# 1. FORZAR HTTPS Y REDIRECCIÓN 301 CANÓNICA
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS si la conexión no es segura
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redireccionar www a versión sin www (canónica)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# 2. PÁGINA PERSONALIZADA DE ERROR 404
ErrorDocument 404 /404.html

# 3. CABECERAS DE SEGURIDAD BÁSICAS
<IfModule mod_headers.c>
  # Forzar HTTPS con HSTS (1 año)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  
  # Evitar que la web sea embebida en iframes externos (Clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # Prevenir MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Control de referrer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. COMPRESIÓN GZIP / DEFLATE (Rendimiento y velocidad)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. CACHÉ DE NAVEGADOR PARA ASSETS ESTÁTICOS
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
